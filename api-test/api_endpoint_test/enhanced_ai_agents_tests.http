Content-Type: application/json
Authorization: Bearer {{access_token}}

### Test 3: Get Data Sources Status
GET {{base_url}}/api/enhanced-ai-agents/data-sources/status
Content-Type: application/json
Authorization: Bearer {{access_token}}

### Test 4: Execute Agent with Real-time Data (Background Task)
POST {{base_url}}/api/enhanced-ai-agents/execute-with-real-time-data
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "agent_id": 1,
  "prompt": "Provide growth strategies for my influencer account",
  "context": {
    "agent_type": "growth_advisor",
    "user_id": 1
  },
  "real_time_data": {
    "trending_content": [
      {
        "platform": "instagram",
        "hashtag": "#fashion",
        "post_count": 1000,
        "engagement_rate": 5.5,
        "trend_score": 0.8
      }
    ],
    "engagement_trends": [
      {
        "platform": "instagram",
        "followers": 50000,
        "engagement_rate": 4.2,
        "reach": 45000,
        "impressions": 50000
      }
    ]
  }
}

### Expected Response:
### {
###   "task_id": "ai_exec_1_1703123456.789",
###   "status": "processing",
###   "message": "AI agent execution started in background",
###   "agent_id": 1,
###   "agent_type": "growth_advisor",
###   "created_at": "2024-01-01T12:00:00"
### }

