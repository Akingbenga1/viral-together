Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "agent_id": 1,
  "prompt": "Provide a comprehensive analysis of my entire social media presence across all platforms, including detailed growth strategies, content recommendations, pricing optimization, and business development plans. This should be a thorough analysis that takes time to complete.",
